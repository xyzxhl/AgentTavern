# 复制为 .env 后填写。任何 OpenAI 兼容端点都可以。
#
#   OpenAI       https://api.openai.com/v1
#   OpenRouter   https://openrouter.ai/api/v1
#   DeepSeek     https://api.deepseek.com/v1
#   本地 vLLM     http://localhost:8000/v1
#
# 不要带 /chat/completions 后缀。

LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=

# **模型名不在这里**（S159）：它按 agent 各设一份，写在
# `agenttavern/prompting/<名字>.yaml` 顶上的 `model` 里——推演用贵的、判定用
# 便宜的、成文再换一个，这些差别按 agent 才说得清。同一份文件顶上还有
# `stream`（这个 agent 流不流）和 `extra`（原样透传的额外请求参数，
# 思考模式那类走这里）。

# director 的 tool loop 可能跑很久，且已放弃流式——超时给足。
LLM_TIMEOUT_SECONDS=300

# 仅对瞬时错误（429 / 5xx / 网络）重试。
LLM_MAX_RETRIES=2

# 会话、节点、trace 的存放位置。
DATA_DIR=data

# 外部资料检索的向量那一路。**留空 = 不启用**，整条链路走纯 BM25。
# 独立的一组：多数人的 chat 与 embedding 未必在同一家。
#
# 阿里云 DashScope 的 key **按大区发**，两个站互不认账，而两边都回
# 401 invalid_api_key，从错误信息上分不出来。北京站是 dashscope.aliyuncs.com，
# 新加坡站是 dashscope-intl.aliyuncs.com——填错的话第一次调用就 401。
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=

# 专业 reranker 端点。**留空 = 用 chat 模型重排**（能排序，不能否决）。
# PROVIDER 可选：cohere / jina / voyage / qwen；写了不认得的名字会当场报错。
# BASE_URL 留空则用那一家的官方地址，自建或代理才填。
#
# qwen 走 DashScope 的**原生**接口，不是 compatible-mode——rerank 没有
# OpenAI 兼容面，所以这里的 BASE_URL 和上面 EMBED 那条不一样：
#   RERANK_BASE_URL=https://dashscope.aliyuncs.com
#   RERANK_MODEL=gte-rerank-v2
RERANK_PROVIDER=
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL=
